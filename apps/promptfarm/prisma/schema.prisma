generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                          String                               @id
  email                       String                               @unique
  createdAt                   DateTime                             @default(now())
  updatedAt                   DateTime                             @updatedAt
  billingAccount              BillingAccount?
  projects                    PromptProject[]
  graphConversation           ThinkingGraphConversationMessage[]
  graphIntakeAnswers          ThinkingGraphIntakeAnswer[]
  graphIntakeQuestions        ThinkingGraphIntakeQuestion[]
  graphPreparedClarifications ThinkingGraphPreparedClarification[]
  graphPreparedDecisions      ThinkingGraphPreparedDecision[]
  graphResolvedDecisions      ThinkingGraphResolvedDecision[]
  runs                        ThinkingGraphRun[]
  sessions                    ThinkingGraphSession[]
  graphOutputs                ThinkingGraphSyntheticOutput[]
  projectFiles                ProjectFile[]
  teamPresets                 TeamPreset[]
  customPersonas              CustomPersona[]
}

model BillingAccount {
  id              String               @id @default(cuid())
  userId          String               @unique
  balance         Int                  @default(0)
  grantedCredits  Int                  @default(0)
  spentCredits    Int                  @default(0)
  refundedCredits Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  user            User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries         BillingLedgerEntry[]
}

model BillingLedgerEntry {
  id               String         @id @default(cuid())
  billingAccountId String
  externalRef      String?        @unique
  type             String
  amount           Int
  balanceAfter     Int
  description      String
  metadata         Json?
  createdAt        DateTime       @default(now())
  billingAccount   BillingAccount @relation(fields: [billingAccountId], references: [id], onDelete: Cascade)

  @@index([billingAccountId, createdAt(sort: Desc)])
}

model PromptProject {
  id                     String                               @id @default(cuid())
  userId                 String
  name                   String
  idea                   String
  status                 String                               @default("active")
  latestSessionId        String?
  projectState           Json?
  createdAt              DateTime                             @default(now())
  updatedAt              DateTime                             @updatedAt
  deletedAt              DateTime?
  user                   User                                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation           ThinkingGraphConversationMessage[]
  intakeAnswers          ThinkingGraphIntakeAnswer[]
  intakeQuestions        ThinkingGraphIntakeQuestion[]
  preparedClarifications ThinkingGraphPreparedClarification[]
  preparedDecisions      ThinkingGraphPreparedDecision[]
  resolvedDecisions      ThinkingGraphResolvedDecision[]
  runs                   ThinkingGraphRun[]
  sessions               ThinkingGraphSession[]
  outputs                ThinkingGraphSyntheticOutput[]
  files                  ProjectFile[]

  @@index([userId, updatedAt(sort: Desc)])
}

model ProjectFile {
  id               String        @id @default(cuid())
  projectId        String
  userId           String
  storageBucket    String
  storagePath      String
  originalName     String
  contentType      String
  sizeBytes        Int
  includeInContext Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  project          PromptProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model ThinkingGraphSession {
  id                     String                               @id
  projectId              String
  userId                 String
  ideaPrompt             String
  provider               Json?
  orchestrator           Json?
  selectedPersonaIds     String[]                             @default([])
  currentPayload         Json?
  projectSpec            Json?
  directorOutput         Json?
  runSummary             Json?
  createdAt              DateTime                             @default(now())
  updatedAt              DateTime                             @updatedAt
  conversation           ThinkingGraphConversationMessage[]
  edges                  ThinkingGraphEdge[]
  intakeAnswers          ThinkingGraphIntakeAnswer[]
  intakeQuestions        ThinkingGraphIntakeQuestion[]
  preparedClarifications ThinkingGraphPreparedClarification[]
  preparedDecisions      ThinkingGraphPreparedDecision[]
  resolvedDecisions      ThinkingGraphResolvedDecision[]
  runs                   ThinkingGraphRun[]
  project                PromptProject                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user                   User                                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  synthetics             ThinkingGraphSynthetic[]
  outputs                ThinkingGraphSyntheticOutput[]
  transcriptEntries      ThinkingGraphTranscriptEntry[]

  @@index([projectId, updatedAt(sort: Desc)])
  @@index([userId, updatedAt(sort: Desc)])
}

model ThinkingGraphSynthetic {
  id           String                             @id @default(cuid())
  sessionId    String
  syntheticId  String
  code         String
  name         String
  role         String
  nodeRole     String?
  status       String
  layoutX      Float
  layoutY      Float
  opinion      Json?
  followUps    Json?
  config       Json
  createdAt    DateTime                           @default(now())
  updatedAt    DateTime                           @updatedAt
  conversation ThinkingGraphConversationMessage[]
  session      ThinkingGraphSession               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  outputs      ThinkingGraphSyntheticOutput[]
  transcript   ThinkingGraphTranscriptEntry[]

  @@unique([sessionId, syntheticId])
  @@index([sessionId, code])
}

model ThinkingGraphEdge {
  id              String               @id @default(cuid())
  sessionId       String
  edgeId          String
  fromSyntheticId String
  toSyntheticId   String
  type            String
  sourceHandle    String?
  targetHandle    String?
  waypoints       Json?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  session         ThinkingGraphSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, edgeId])
  @@index([sessionId, fromSyntheticId])
  @@index([sessionId, toSyntheticId])
}

model ThinkingGraphRun {
  id                     String                               @id
  sessionId              String
  projectId              String
  userId                 String
  status                 ThinkingGraphRunStatus               @default(completed)
  ideaPrompt             String
  versionLabel           String?
  parentRunId            String?
  runReason              String?
  provider               Json?
  orchestrator           Json?
  projectSpec            Json?
  directorOutput         Json?
  runSummary             Json?
  graphPayload           Json?
  startedAt              DateTime                             @default(now())
  completedAt            DateTime?
  createdAt              DateTime                             @default(now())
  updatedAt              DateTime                             @updatedAt
  preparedClarifications ThinkingGraphPreparedClarification[]
  preparedDecisions      ThinkingGraphPreparedDecision[]
  project                PromptProject                        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session                ThinkingGraphSession                 @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user                   User                                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  outputs                ThinkingGraphSyntheticOutput[]
  transcript             ThinkingGraphTranscriptEntry[]

  @@index([sessionId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
}

model ThinkingGraphSyntheticOutput {
  id                  String                  @id @default(cuid())
  runId               String
  sessionId           String
  projectId           String
  userId              String
  syntheticRecordId   String?
  syntheticId         String
  syntheticName       String
  outputKind          ThinkingGraphOutputKind @default(synthetic)
  summary             String?
  details             String?
  recommendation      String?
  topRecommendation   String?
  strategicOptions    Json?
  conflictResolution  Json?
  changesFromPrevious Json?
  appliedInputs       Json?
  ignoredInputs       Json?
  keyRisks            Json?
  concernLevels       Json?
  handoff             String?
  upstreamContext     Json?
  directedHandoffs    Json?
  operational         Json?
  outputQuality       Json?
  model               Json?
  tokenUsage          Json?
  raw                 Json?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  project             PromptProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run                 ThinkingGraphRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  session             ThinkingGraphSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  syntheticRecord     ThinkingGraphSynthetic? @relation(fields: [syntheticRecordId], references: [id])
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([runId, syntheticId])
  @@index([sessionId, syntheticId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
}

model ThinkingGraphTranscriptEntry {
  id                String                      @id @default(cuid())
  runId             String
  sessionId         String
  syntheticRecordId String?
  syntheticId       String
  entryIndex        Int
  type              ThinkingGraphTranscriptType
  text              String
  createdAt         DateTime                    @default(now())
  run               ThinkingGraphRun            @relation(fields: [runId], references: [id], onDelete: Cascade)
  session           ThinkingGraphSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  syntheticRecord   ThinkingGraphSynthetic?     @relation(fields: [syntheticRecordId], references: [id])

  @@unique([runId, entryIndex])
  @@index([sessionId, syntheticId, createdAt(sort: Desc)])
}

model ThinkingGraphConversationMessage {
  id                     String                        @id @default(cuid())
  sessionId              String
  projectId              String
  userId                 String
  syntheticRecordId      String?
  syntheticId            String
  messageId              String
  role                   ThinkingGraphConversationRole
  text                   String
  includeInNextIteration Boolean                       @default(true)
  createdAt              DateTime
  insertedAt             DateTime                      @default(now())
  project                PromptProject                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session                ThinkingGraphSession          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  syntheticRecord        ThinkingGraphSynthetic?       @relation(fields: [syntheticRecordId], references: [id])
  user                   User                          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, messageId])
  @@index([sessionId, syntheticId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
}

model ThinkingGraphIntakeQuestion {
  id                  String                      @id @default(cuid())
  sessionId           String
  projectId           String
  raisedBySyntheticId String?
  userId              String
  questionId          String
  question            String
  whyItMatters        String
  required            Boolean
  suggestedAnswer     String?
  source              String
  createdAt           DateTime                    @default(now())
  answers             ThinkingGraphIntakeAnswer[]
  project             PromptProject               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session             ThinkingGraphSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user                User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, questionId])
  @@index([projectId, createdAt(sort: Desc)])
}

model ThinkingGraphIntakeAnswer {
  id               String                      @id @default(cuid())
  sessionId        String
  projectId        String
  userId           String
  intakeQuestionId String
  answer           String
  answeredAt       DateTime
  createdAt        DateTime                    @default(now())
  intakeQuestion   ThinkingGraphIntakeQuestion @relation(fields: [intakeQuestionId], references: [id], onDelete: Cascade)
  project          PromptProject               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session          ThinkingGraphSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user             User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, answeredAt(sort: Desc)])
  @@index([projectId, answeredAt(sort: Desc)])
}

model ThinkingGraphPreparedDecision {
  id                String                            @id @default(cuid())
  sessionId         String
  runId             String?
  projectId         String
  userId            String
  syntheticId       String
  decisionTitle     String
  optionId          String
  optionLabel       String
  optionDescription String
  source            ThinkingGraphPreparedInputSource?
  appliedAt         DateTime
  createdAt         DateTime                          @default(now())
  project           PromptProject                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run               ThinkingGraphRun?                 @relation(fields: [runId], references: [id], onDelete: Cascade)
  session           ThinkingGraphSession              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user              User                              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, syntheticId, appliedAt(sort: Desc)])
  @@index([runId, syntheticId])
}

model ThinkingGraphPreparedClarification {
  id            String                             @id @default(cuid())
  sessionId     String
  runId         String?
  projectId     String
  userId        String
  syntheticId   String
  syntheticName String
  source        ThinkingGraphPreparedInputSource?
  appliedAt     DateTime
  createdAt     DateTime                           @default(now())
  answers       ThinkingGraphClarificationAnswer[]
  project       PromptProject                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  run           ThinkingGraphRun?                  @relation(fields: [runId], references: [id], onDelete: Cascade)
  session       ThinkingGraphSession               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user          User                               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, syntheticId, appliedAt(sort: Desc)])
  @@index([runId, syntheticId])
}

model ThinkingGraphClarificationAnswer {
  id                      String                             @id @default(cuid())
  preparedClarificationId String
  questionId              String
  questionLabel           String
  answer                  String
  createdAt               DateTime                           @default(now())
  preparedClarification   ThinkingGraphPreparedClarification @relation(fields: [preparedClarificationId], references: [id], onDelete: Cascade)

  @@index([preparedClarificationId])
}

model ThinkingGraphResolvedDecision {
  id                String                            @id @default(cuid())
  sessionId         String
  projectId         String
  userId            String
  syntheticId       String
  decisionTitle     String
  optionId          String
  optionLabel       String
  optionDescription String
  source            ThinkingGraphPreparedInputSource?
  appliedAt         DateTime
  createdAt         DateTime                          @default(now())
  project           PromptProject                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  session           ThinkingGraphSession              @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user              User                              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, syntheticId, appliedAt(sort: Desc)])
  @@index([projectId, appliedAt(sort: Desc)])
}

enum ThinkingGraphRunStatus {
  draft
  running
  completed
  failed
}

enum ThinkingGraphOutputKind {
  synthetic
  advisor
}

enum ThinkingGraphConversationRole {
  system
  user
  synthetic
}

enum ThinkingGraphTranscriptType {
  opinion
  followup
  adjustment
  included
}

enum ThinkingGraphPreparedInputSource {
  defaults
  manual_edit
}

model TeamPreset {
  id          String               @id @default(cuid())
  userId      String
  name        String
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  members     TeamPresetMember[]
  connections TeamPresetConnection[]

  @@index([userId, createdAt(sort: Desc)])
}

model TeamPresetMember {
  id               String               @id @default(cuid())
  teamId           String
  personaId        String?
  customPersonaId  String?
  name             String
  domain           String
  skillDescription String
  team             TeamPreset           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  customPersona    CustomPersona?       @relation(fields: [customPersonaId], references: [id], onDelete: SetNull)
  fromConnections  TeamPresetConnection[] @relation("ConnectionFrom")
  toConnections    TeamPresetConnection[] @relation("ConnectionTo")

  @@index([teamId])
}

model CustomPersona {
  id               String             @id @default(cuid())
  userId           String
  name             String
  domain           String
  skillDescription String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamMembers      TeamPresetMember[]

  @@index([userId, createdAt(sort: Desc)])
}

model TeamPresetConnection {
  id     String           @id @default(cuid())
  teamId String
  fromId String
  toId   String
  type   String
  team   TeamPreset       @relation(fields: [teamId], references: [id], onDelete: Cascade)
  from   TeamPresetMember @relation("ConnectionFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to     TeamPresetMember @relation("ConnectionTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([teamId])
}
