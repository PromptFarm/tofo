{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "tofo-desktop",
  "version": "0.1.0",
  "identifier": "com.tofo.desktop",
  "build": {
    "frontendDist": "../frontend-placeholder",
    "devUrl": "http://localhost:3100",
    "beforeDevCommand": "PORT=3100 pnpm --dir ../promptfarm dev",
    "beforeBuildCommand": "pnpm --dir ../promptfarm build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "TOFO",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../promptfarm/.next/next-standalone.tar.gz": "next-standalone.tar.gz"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
